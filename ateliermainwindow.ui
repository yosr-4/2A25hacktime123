<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>AtelierMainWindow</class>
 <widget class="QMainWindow" name="AtelierMainWindow">
  <property name="geometry"><rect><x>0</x><y>0</y><width>1536</width><height>960</height></rect></property>
  <property name="windowTitle"><string>HackTime - Gestion des Ateliers</string></property>
  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet"><string notr="true">
QWidget#centralwidget { background-color: #F3F6FB; }
QWidget { font-family: "Segoe UI", "Inter", "Noto Sans", "Helvetica Neue", sans-serif; font-size: 13px; color: #1B2A4A; }

/* ---------- Sidebar ---------- */
QFrame#sidebar { background-color: #0B1630; }
QFrame#sidebar QLabel#logo { color: white; font-size: 26px; font-weight: 800; padding-left: 6px; }
QFrame#sidebar QLabel#tagline { color: #8FA2CC; font-size: 12px; padding-left: 6px; }
QFrame#sidebar QPushButton { color: #C9D4EE; background-color: transparent; border: none; text-align: left; padding: 13px 16px; border-radius: 10px; font-size: 14px; font-weight: 600; }
QFrame#sidebar QPushButton:hover { background-color: #16254A; color: white; }
QFrame#sidebar QPushButton[active="true"] { background-color: #1665E8; color: white; }

/* ---------- Top bar ---------- */
QFrame#topbar { background-color: white; border: none; border-bottom: 1px solid #E4EAF4; }
QLineEdit#topSearch { background-color: #F3F6FB; border: 1px solid #E4EAF4; border-radius: 20px; padding: 9px 16px; }
QLabel#bell { font-size: 18px; }
QLabel#admin { font-size: 14px; }

/* ---------- Cards ---------- */
QFrame#cardHeader, QFrame#cardKpi1, QFrame#cardKpi2, QFrame#cardKpi3, QFrame#cardKpi4,
QFrame#cardList, QFrame#cardDetails, QFrame#cardAdd, QFrame#cardStatut, QFrame#cardActions {
  background-color: white; border: 1px solid #E6ECF5; border-radius: 14px; }
QLabel#headerIcon { background-color: #E8F0FE; border-radius: 18px; font-size: 32px; qproperty-alignment: AlignCenter; }
QLabel#lblTitle { font-size: 26px; font-weight: 800; color: #0B1630; }
QLabel#lblSub { color: #6B7A99; font-size: 13px; }
QLabel#kpiIcon1, QLabel#kpiIcon2, QLabel#kpiIcon3, QLabel#kpiIcon4 { border-radius: 23px; font-size: 20px; qproperty-alignment: AlignCenter; }
QLabel#kpiIcon1 { background-color: #E8F0FE; }
QLabel#kpiIcon2 { background-color: #E6F7EE; }
QLabel#kpiIcon3 { background-color: #F2EAFE; }
QLabel#kpiIcon4 { background-color: #FFF1E0; }
QLabel#kpiTitle1, QLabel#kpiTitle2, QLabel#kpiTitle3, QLabel#kpiTitle4 { color: #6B7A99; font-size: 12px; }
QLabel#kpiTotal, QLabel#kpiCapacite, QLabel#kpiComps, QLabel#kpiAvenir { font-size: 26px; font-weight: 800; color: #0B1630; }
QLabel#lblList, QLabel#lblDetails, QLabel#lblAdd, QLabel#lblStats, QLabel#lblActions { font-size: 16px; font-weight: 700; color: #0B1630; }
QLabel#fCompLabel, QLabel#fStatutLabel, QLabel#fDateLabel, QLabel#fSortLabel { color: #6B7A99; font-size: 11px; font-weight: 600; }

/* ---------- Inputs ---------- */
QLineEdit, QComboBox, QDateTimeEdit, QSpinBox, QPlainTextEdit { background-color: white; border: 1px solid #D9E1EE; border-radius: 8px; padding: 7px 10px; selection-background-color: #1665E8; }
QLineEdit:focus, QComboBox:focus, QDateTimeEdit:focus, QSpinBox:focus, QPlainTextEdit:focus { border: 1px solid #1665E8; }
QComboBox QAbstractItemView { background: white; border: 1px solid #D9E1EE; selection-background-color: #E8F0FE; selection-color: #1665E8; }

/* ---------- Buttons ---------- */
QPushButton { background-color: white; color: #1B2A4A; border: 1px solid #D9E1EE; border-radius: 9px; padding: 9px 16px; font-weight: 600; }
QPushButton:hover { background-color: #F3F6FB; border-color: #1665E8; color: #1665E8; }
QPushButton:disabled { color: #A9B4CC; background-color: #F7F9FC; border-color: #E6ECF5; }
QPushButton#btnSave, QPushButton#btnDetails { background-color: #1665E8; color: white; border: none; }
QPushButton#btnSave:hover, QPushButton#btnDetails:hover { background-color: #0F52C2; color: white; }
QPushButton#btnDelete { color: #D92D20; border-color: #F5C2BE; }
QPushButton#btnDelete:hover { background-color: #FDECEA; border-color: #D92D20; color: #D92D20; }
QPushButton#btnPrev, QPushButton#btnNext { padding: 6px 12px; }

/* ---------- Table ---------- */
QTableWidget { background-color: white; border: none; alternate-background-color: #FAFBFE; selection-background-color: #E8F0FE; selection-color: #1665E8; outline: 0; }
QTableWidget::item { padding: 4px 8px; border-bottom: 1px solid #EEF2F8; }
QHeaderView::section { background-color: #F3F6FB; color: #6B7A99; border: none; padding: 10px 8px; font-weight: 700; font-size: 12px; }

/* ---------- Details ---------- */
QFrame#detailHead { background-color: #F3F8FF; border: 1px solid #DCE9FD; border-radius: 12px; }
QLabel#dIco { background-color: #E8F0FE; border-radius: 12px; font-size: 22px; qproperty-alignment: AlignCenter; }
QLabel#dNom { font-size: 15px; font-weight: 700; color: #0B1630; }
QLabel#dId { color: #6B7A99; font-size: 12px; }
QLabel#dBadge { background-color: #E8F0FE; color: #1665E8; border-radius: 10px; padding: 4px 10px; font-weight: 700; font-size: 11px; }
QLabel#dCompLabel, QLabel#dDateLabel, QLabel#dDureeLabel, QLabel#dSalleLabel, QLabel#dCapLabel, QLabel#dDescLabel { color: #6B7A99; }
QLabel#dComp, QLabel#dDate, QLabel#dDuree, QLabel#dSalle, QLabel#dCap, QLabel#dDesc { font-weight: 600; }
QLabel#aIdLabel, QLabel#aTitreLabel, QLabel#aCompLabel, QLabel#aDateLabel, QLabel#aDureeLabel, QLabel#aCapLabel, QLabel#aSalleLabel, QLabel#aDescLabel { color: #6B7A99; font-weight: 600; }
QLabel#aId { font-weight: 700; color: #1665E8; }
QLabel#aErr { color: #D92D20; font-weight: 600; }
QLabel#aConflict { color: #B54708; font-weight: 600; }

/* ---------- Stats legend ---------- */
QLabel#dotAvenir { color: #1665E8; } QLabel#dotCours { color: #16A34A; } QLabel#dotTermine { color: #94A3B8; }
QLabel#legAvenir, QLabel#legCours, QLabel#legTermine { font-weight: 700; }
QLabel#lblMoyenne { color: #6B7A99; }

QScrollArea#rightScroll { background: transparent; border: none; }
QWidget#rightCol, QWidget#body, QWidget#content, QWidget#leftCol, QWidget#kpiRow { background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #CBD5E8; border-radius: 5px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QStatusBar { background: white; color: #6B7A99; }
</string></property>
