      <widget class="QWidget" name="pageAteliers">
       <property name="styleSheet">
        <string notr="true">
QWidget#pageAteliers { background-color: #F3F6FB; }
QWidget { font-family: "Segoe UI", "Inter", "Noto Sans", "Helvetica Neue", sans-serif; font-size: 13px; color: #1B2A4A; }

/* ---------- Sidebar ---------- */
QFrame#sidebarAtelier { background-color: #0B1630; }
QFrame#sidebarAtelier QLabel#logoAtelier { color: white; font-size: 26px; font-weight: 800; padding-left: 6px; }
QFrame#sidebarAtelier QLabel#tagline { color: #8FA2CC; font-size: 12px; padding-left: 6px; }
QFrame#sidebarAtelier QPushButton { color: #C9D4EE; background-color: transparent; border: none; text-align: left; padding: 13px 16px; border-radius: 10px; font-size: 14px; font-weight: 600; }
QFrame#sidebarAtelier QPushButton:hover { background-color: #16254A; color: white; }
QFrame#sidebarAtelier QPushButton[active="true"] { background-color: #1665E8; color: white; }

/* ---------- Top bar ---------- */
QFrame#topbarAtelier { background-color: white; border: none; border-bottom: 1px solid #E4EAF4; }
QLineEdit#topSearchAtelier { background-color: #F3F6FB; border: 1px solid #E4EAF4; border-radius: 20px; padding: 9px 16px; }
QLabel#bellAtelier { font-size: 18px; }
QLabel#adminAtelier { font-size: 14px; }

/* ---------- Cards ---------- */
QFrame#cardHeaderAtelier, QFrame#cardKpi1Atelier, QFrame#cardKpi2Atelier, QFrame#cardKpi3Atelier, QFrame#cardKpi4Atelier,
QFrame#cardListAtelier, QFrame#cardDetailsAtelier, QFrame#cardAddAtelier, QFrame#cardStatutAtelier, QFrame#cardActionsAtelier {
  background-color: white; border: 1px solid #E6ECF5; border-radius: 14px; }
QLabel#headerIconAtelier { background-color: #E8F0FE; border-radius: 18px; font-size: 32px; qproperty-alignment: AlignCenter; }
QLabel#lblTitleAtelier { font-size: 26px; font-weight: 800; color: #0B1630; }
QLabel#lblSubAtelier { color: #6B7A99; font-size: 13px; }
QLabel#kpiIcon1Atelier, QLabel#kpiIcon2Atelier, QLabel#kpiIcon3Atelier, QLabel#kpiIcon4Atelier { border-radius: 23px; font-size: 20px; qproperty-alignment: AlignCenter; }
QLabel#kpiIcon1Atelier { background-color: #E8F0FE; }
QLabel#kpiIcon2Atelier { background-color: #E6F7EE; }
QLabel#kpiIcon3Atelier { background-color: #F2EAFE; }
QLabel#kpiIcon4Atelier { background-color: #FFF1E0; }
QLabel#kpiTitle1Atelier, QLabel#kpiTitle2Atelier, QLabel#kpiTitle3Atelier, QLabel#kpiTitle4Atelier { color: #6B7A99; font-size: 12px; }
QLabel#kpiTotalAtelier, QLabel#kpiCapacite, QLabel#kpiComps, QLabel#kpiAvenir { font-size: 26px; font-weight: 800; color: #0B1630; }
QLabel#lblListAtelier, QLabel#lblDetailsAtelier, QLabel#lblAddAtelier, QLabel#lblStats, QLabel#lblActionsAtelier { font-size: 16px; font-weight: 700; color: #0B1630; }
QLabel#fCompLabel, QLabel#fStatutLabelAtelier, QLabel#fDateLabelAtelier, QLabel#fSortLabelAtelier { color: #6B7A99; font-size: 11px; font-weight: 600; }

/* ---------- Inputs ---------- */
QLineEdit, QComboBox, QDateTimeEdit, QSpinBox, QPlainTextEdit { background-color: white; border: 1px solid #D9E1EE; border-radius: 8px; padding: 7px 10px; selection-background-color: #1665E8; }
QLineEdit:focus, QComboBox:focus, QDateTimeEdit:focus, QSpinBox:focus, QPlainTextEdit:focus { border: 1px solid #1665E8; }
QComboBox QAbstractItemView { background: white; border: 1px solid #D9E1EE; selection-background-color: #E8F0FE; selection-color: #1665E8; }

/* ---------- Buttons ---------- */
QPushButton { background-color: white; color: #1B2A4A; border: 1px solid #D9E1EE; border-radius: 9px; padding: 9px 16px; font-weight: 600; }
QPushButton:hover { background-color: #F3F6FB; border-color: #1665E8; color: #1665E8; }
QPushButton:disabled { color: #A9B4CC; background-color: #F7F9FC; border-color: #E6ECF5; }
QPushButton#btnSaveAtelier, QPushButton#btnDetailsAtelier { background-color: #1665E8; color: white; border: none; }
QPushButton#btnSaveAtelier:hover, QPushButton#btnDetailsAtelier:hover { background-color: #0F52C2; color: white; }
QPushButton#btnDelete { color: #D92D20; border-color: #F5C2BE; }
QPushButton#btnDelete:hover { background-color: #FDECEA; border-color: #D92D20; color: #D92D20; }
QPushButton#btnPrevAtelier, QPushButton#btnNextAtelier { padding: 6px 12px; }

/* ---------- Table ---------- */
QTableWidget { background-color: white; border: none; alternate-background-color: #FAFBFE; selection-background-color: #E8F0FE; selection-color: #1665E8; outline: 0; }
QTableWidget::item { padding: 4px 8px; border-bottom: 1px solid #EEF2F8; }
QHeaderView::section { background-color: #F3F6FB; color: #6B7A99; border: none; padding: 10px 8px; font-weight: 700; font-size: 12px; }

/* ---------- Details ---------- */
QFrame#detailHeadAtelier { background-color: #F3F8FF; border: 1px solid #DCE9FD; border-radius: 12px; }
QLabel#dIcoAtelier { background-color: #E8F0FE; border-radius: 12px; font-size: 22px; qproperty-alignment: AlignCenter; }
QLabel#dNomAtelier { font-size: 15px; font-weight: 700; color: #0B1630; }
QLabel#dIdAtelier { color: #6B7A99; font-size: 12px; }
QLabel#dBadgeAtelier { background-color: #E8F0FE; color: #1665E8; border-radius: 10px; padding: 4px 10px; font-weight: 700; font-size: 11px; }
QLabel#dCompLabel, QLabel#dDateLabel, QLabel#dDureeLabel, QLabel#dSalleLabelAtelier, QLabel#dCapLabel, QLabel#dDescLabel { color: #6B7A99; }
QLabel#dComp, QLabel#dDate, QLabel#dDuree, QLabel#dSalleAtelier, QLabel#dCap, QLabel#dDesc { font-weight: 600; }
QLabel#aIdLabelAtelier, QLabel#aTitreLabel, QLabel#aCompLabel, QLabel#aDateLabel, QLabel#aDureeLabel, QLabel#aCapLabel, QLabel#aSalleLabelAtelier, QLabel#aDescLabel { color: #6B7A99; font-weight: 600; }
QLabel#aIdAtelier { font-weight: 700; color: #1665E8; }
QLabel#aErrAtelier { color: #D92D20; font-weight: 600; }
QLabel#aConflictAtelier { color: #B54708; font-weight: 600; }

/* ---------- Stats legend ---------- */
QLabel#dotAvenir { color: #1665E8; } QLabel#dotCoursAtelier { color: #16A34A; } QLabel#dotTermine { color: #94A3B8; }
QLabel#legAvenir, QLabel#legCoursAtelier, QLabel#legTermine { font-weight: 700; }
QLabel#lblMoyenne { color: #6B7A99; }

QScrollArea#rightScrollAtelier { background: transparent; border: none; }
QWidget#rightColAtelier, QWidget#bodyAtelier, QWidget#contentAtelier, QWidget#leftColAtelier, QWidget#kpiRowAtelier { background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #CBD5E8; border-radius: 5px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QStatusBar { background: white; color: #6B7A99; }
</string>
