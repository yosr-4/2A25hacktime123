      <widget class="QWidget" name="pageParticipants">
       <property name="styleSheet">
        <string notr="true">/* HackTime - feuille de style de l'application.
   Chargee au demarrage dans main.cpp (voir ressources.qrc). */

* { font-family: 'Segoe UI', 'Inter', 'Arial'; font-size: 13px; color: #1E293B; }
#pageCompetitions, #pageParticipants { background: #F3F6FC; }

/* ---- menu de gauche */
#sidebarPart { background: #0E1A2B; }
#sidebarPart QLabel { color: white; }
#sidebarPart QPushButton { text-align: left; padding: 12px 18px; border: none; border-radius: 10px;
    color: #C9D3E3; font-size: 15px; background: transparent; }
#sidebarPart QPushButton:hover { background: rgba(255, 255, 255, 0.07); color: #FFFFFF; }
#sidebarPart QPushButton:checked { background: #2563EB; color: #FFFFFF; font-weight: 700; }

/* ---- barre du haut */
#topbarComp { background: white; }
#topSearchComp { background: #EAF1FC; border: 1px solid #D5E1F5; border-radius: 8px; padding: 9px 12px; }
#bellComp { font-size: 20px; }

/* ---- cartes (propriete dynamique card / role / kind) */
QFrame[card="true"] { background: white; border-radius: 12px; border: 1px solid #E8EEF8; }
QLabel[role="cardTitle"] { font-size: 16px; font-weight: 700; }
QLabel[role="kpiTitle"] { color: #475569; }
QLabel[role="kpiValue"] { font-size: 24px; font-weight: 800; }
QLabel[role="kpiIcon"] { border-radius: 10px; font-size: 22px; }
QLabel[role="filterLabel"] { font-size: 11px; color: #475569; }
#headerIconComp { background: #1665E8; border-radius: 14px; font-size: 34px; }
#lblTitleComp { font-size: 26px; font-weight: 800; }
#lblSubComp { color: #4B5D7A; font-size: 14px; }
#kpiIcon1Comp { background: #3B82F6; }
#kpiIcon2Comp { background: #22A66B; }
#kpiIcon3Comp { background: #7C5CE6; }
#kpiIcon4Comp { background: #F59E0B; }
#footerComp { color: #64748B; }
#detailHeadComp { background: #F3F7FD; border-radius: 10px; border: 1px solid #E1EAF7; }
#dIcoComp { font-size: 28px; }
#dNomComp { font-weight: 700; }
#dIdComp { color: #64748B; }
#aErrComp { color: #DC2626; font-size: 12px; }
#dotCoursComp { color: #2E9E5B; }
#dotPlanifiee { color: #2563EB; }
#dotTerminee { color: #94A3B8; }

/* ---- boutons */
QPushButton[kind="primary"] { background: #1665E8; color: white; border: none; border-radius: 8px;
    padding: 11px 18px; font-weight: 600; font-size: 14px; }
QPushButton[kind="primary"]:hover { background: #0F52C4; }
QPushButton[kind="outline"] { background: white; color: #1665E8; border: 1px solid #1665E8;
    border-radius: 8px; padding: 11px 18px; font-weight: 600; font-size: 14px; }
QPushButton[kind="outline"]:hover { background: #EEF4FF; }
QPushButton#act { border: none; background: transparent; font-size: 16px; padding: 4px; }
QPushButton#act:hover { background: #EEF4FF; border-radius: 6px; }
QPushButton#page { background: #EEF3FB; border: none; border-radius: 6px; padding: 8px 12px; }
QPushButton#pageOn { background: #1665E8; color: white; border: none; border-radius: 6px; padding: 8px 14px; }

/* ---- champs et tableau */
QLineEdit, QComboBox, QDateEdit, QSpinBox { background: white; border: 1px solid #D5DFEE;
    border-radius: 8px; padding: 7px 10px; }
QComboBox QAbstractItemView { background: white; selection-background-color: #DCE9FF;
    selection-color: #1E293B; color: #1E293B; }
QTableWidget { background: white; border: none; gridline-color: #EEF2F8;
    selection-background-color: #EAF2FF; selection-color: #1E293B; }
QTableWidget::item { border-bottom: 1px solid #EEF2F8; padding-left: 6px; }
QHeaderView::section { background: #F6F8FC; border: none; padding: 10px 6px;
    font-weight: 700; font-size: 12px; }

/* ---- colonne droite defilante */
#rightScrollComp, #rightColComp { background: transparent; border: none; }
#rightScrollComp QScrollBar:vertical { background: #E6ECF6; width: 10px; margin: 0; border-radius: 5px; }
#rightScrollComp QScrollBar::handle:vertical { background: #8FA6CF; border-radius: 5px; min-height: 40px; }
#rightScrollComp QScrollBar::handle:vertical:hover { background: #1665E8; }
#rightScrollComp QScrollBar::add-line:vertical, #rightScrollComp QScrollBar::sub-line:vertical { height: 0; }
#rightScrollComp QScrollBar::add-page:vertical, #rightScrollComp QScrollBar::sub-page:vertical { background: transparent; }

/* ---- fenetres secondaires (modifier, messages, calendrier) */
QDialog { background: white; }
QDialog QPushButton { background: #1665E8; color: white; border: none; border-radius: 6px;
    padding: 7px 18px; font-weight: 600; }
QDialog QPushButton:hover { background: #0F52C4; }
QCalendarWidget QWidget { background: white; alternate-background-color: #F6F8FC; }
QCalendarWidget QAbstractItemView { selection-background-color: #1665E8; selection-color: white; }
QCalendarWidget QToolButton { background: transparent; border: none; padding: 4px 8px; }
QMenu { background: white; border: 1px solid #D5DFEE; border-radius: 8px; padding: 6px; }
QMenu::item { padding: 9px 20px; border-radius: 6px; }
QMenu::item:selected { background: #DCE9FF; }
QMenu::item:disabled { color: #94A3B8; }

/* ---- page de connexion (PLoginCompet) : thème sombre, néons bleus, accents orange */
#cardLoginCompet { border-image: url(:/images/login_card.png) 0 0 0 0 stretch stretch; }
#cardLoginCompet QLabel { color: #FFFFFF; background: transparent; }
#lblLoginCompet, #lblPWDCompet { font-size: 16px; }
#lblErrLoginCompet { color: #FF8A8A; font-size: 13px; }
#EditLoginCompet, #EditPWDCompet { background: rgba(37, 78, 160, 0.55); color: #FFFFFF;
    border: 1px solid #2E66C9; border-radius: 10px; padding: 8px 14px; font-size: 15px;
    selection-background-color: #FF7A1A; selection-color: #FFFFFF; }
#EditLoginCompet:hover, #EditPWDCompet:hover { border: 2px solid #FF8C2E; }
#EditLoginCompet:focus, #EditPWDCompet:focus { border: 2px solid #FF7A1A; background: rgba(37, 78, 160, 0.75); }
#BForgotCompet { border: none; background: transparent; color: #FF8C2E; font-size: 15px;
    font-weight: 600; padding: 2px 6px; }
#BForgotCompet:hover { color: #FFA45C; text-decoration: underline; }
#BLoginCompet { background: #FF6B00; color: #FFFFFF; border: none; border-radius: 12px;
    font-size: 17px; font-weight: 600; padding: 0; }
#BLoginCompet:hover { background: #FF8124; }
#BLoginCompet:pressed { background: #E05E00; }

/* ---- statistiques par thème */
QProgressBar#themeBar { background: #EEF3FB; border: none; border-radius: 4px; }
QProgressBar#themeBar::chunk { background: #1665E8; border-radius: 4px; }
#topbarComp #adminComp { padding: 6px 10px; border-radius: 8px; }
#topbarComp #adminComp:hover { background: #EEF4FF; }

#contenuParticipants { background:#F4F7FC; }</string>
       </property>
